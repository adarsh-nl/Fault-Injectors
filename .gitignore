/datasets/
*.zip
*.bin
*.ply
*.png
*.jpg
*.jpeg
*.pcd

# ...but bundled package assets are source, keep them
!src/fault_injectors/assets/*.png

# Notebook checkpoints
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
.env
venv/
.venv/

# OS
.DS_Store
Thumbs.db

# dataset and rendered outputs (not source)
main/
results/
output_animation.mp4
*.mp4
src/fault_injectors/npy/

# SLURM job logs and run outputs
# SLURM job logs. Matched on the JOB-ID SUFFIX rather than the per-job name
# prefix, because every sbatch here writes <name>-%j.{out,err} and a
# prefix-based rule needs a new line for every new script -- a076f70 added
# dryrun-*, and lossfix-* was then committed for want of one. This catches
# any <anything>-<digits>.out/.err, so a new job script never needs an edit.
*-[0-9]*.out
*-[0-9]*.err
slurm-*.out
slurm-*.err
results/
cora-results/
cora-dryrun/

# Local assistant context, not part of the artifact
CLAUDE.md
.claude/
nan-diag-*.out
nan-diag-*.err
cora-nan-diag/
