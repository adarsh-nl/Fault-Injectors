# Downloaded dataset files - never push these (root-level only;
# src/datasets/ is source code)
/datasets/
*.zip
*.bin
*.ply
*.png
*.jpg
*.jpeg
*.pcd

# ...but bundled package assets are source, keep them
!src/fault_injectors/assets/*.png

# Notebook checkpoints
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
.env
venv/
.venv/

# OS
.DS_Store
Thumbs.db

# dataset and rendered outputs (not source)
main/
results/
output_animation.mp4
*.mp4
src/fault_injectors/npy/

# SLURM job logs and run outputs
# SLURM job logs. Matched on the JOB-ID SUFFIX rather than the per-job name
# prefix, because every sbatch here writes <name>-%j.{out,err} and a
# prefix-based rule needs a new line for every new script -- a076f70 added
# dryrun-*, and lossfix-* was then committed for want of one. This catches
# any <anything>-<digits>.out/.err, so a new job script never needs an edit.
*-[0-9]*.out
*-[0-9]*.err
slurm-*.out
slurm-*.err
results/
cora-results/
cora-dryrun/

# Local assistant context, not part of the artifact
CLAUDE.md
.claude/
nan-diag-*.out
nan-diag-*.err
cora-nan-diag/

# results/ scaffold (must stay after the results/ rules on lines 31 and 46).
# Those are directory patterns, so git never descends into results/ and a bare
# negation of a file inside it would not fire. Re-include the directory, then
# re-exclude its contents, then re-include exactly the four scaffold files:
# the eval protocol spec and the scripts that write and render cells.
# Everything they generate -- cells/*.json, RESULTS.md, run bundles -- stays
# ignored. Every pattern here is anchored with a leading / so it applies only
# to the root results/; a nested results/ dir stays ignored by lines 31/46.
!/results/
/results/*
!/results/table_spec.json
!/results/record_result.py
!/results/render_table.py
!/results/README.md
